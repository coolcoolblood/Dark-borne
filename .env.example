# Stock Afterhours Analysis - Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# ====== REQUIRED ======

# EODHD API Key (required)
# Get your API key from: https://eodhd.com/
EODHD_API_KEY=your_api_key_here

# ====== OPTIONAL ======

# Output directory for Excel files (default: ~/stock_analysis)
OUTPUT_DIR=/path/to/output/directory

# Exchange code (default: US)
EXCHANGE_CODE=US

# Minimum full day turnover in millions USD (default: 5.0)
MIN_DAY_TURNOVER=5.0

# Minimum afterhours turnover in millions USD (default: 1.0)
MIN_AH_TURNOVER=1.0

# Minimum afterhours gain percentage (default: 10.0)
MIN_AH_GAIN=10.0

# API request timeout in seconds (default: 20)
API_TIMEOUT=20

# Maximum number of retry attempts for failed API calls (default: 3)
MAX_RETRIES=3

# Delay between API calls in seconds for rate limiting (default: 0.5)
RATE_LIMIT_DELAY=0.5
